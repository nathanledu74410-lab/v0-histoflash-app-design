# Copie ce fichier en .env.local et remplis les valeurs.
# Chaque service est optionnel : sans clé, le site fonctionne en mode dégradé
# (fiches et quiz express accessibles, fonctions du service désactivées).

# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://histoflash.fr
NEXT_PUBLIC_CONTACT_EMAIL=contact@histoflash.fr

# ─── Clerk (comptes) — https://dashboard.clerk.com ───────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/inscription

# ─── Neon (base PostgreSQL) — https://console.neon.tech ──
DATABASE_URL=

# ─── Stripe (paiement) — https://dashboard.stripe.com ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix récurrents (price_…) : 4,99 €/mois et 29,99 €/an
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ─── Assistant IA (Google Gemini) — https://aistudio.google.com ─
GOOGLE_GENERATIVE_AI_API_KEY=
# Optionnel : modèle Gemini à utiliser
GEMINI_MODEL=gemini-2.5-flash-lite
